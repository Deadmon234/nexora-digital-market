# ── Développement local ───────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/nexora_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Production (décommenter et adapter) ───────────────────────────
# DATABASE_URL=jdbc:postgresql://localhost:5432/nexora_prod
# DATABASE_USERNAME=nexora
# DATABASE_PASSWORD=change_me
# CORS_ALLOWED_ORIGINS=https://nexora.example.com

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
